# Base URL the browser uses for API calls. Keep "/api" (same-origin through the
# proxy) unless the API is served from another origin, e.g. http://localhost:3000/api.
VITE_API_BASE_URL=/api

# Where the Vite dev/preview server proxies /api requests (the NestJS API).
VITE_API_PROXY_TARGET=http://localhost:3000
