NODE_ENV=development
PORT=3000
LOG_LEVEL=info

MONGO_URI=mongodb://localhost:27017/auth_app

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# The web app's origin. Requests normally arrive same-origin through the proxy.
CORS_ORIGIN=http://localhost:5173

# Set to 1 when running behind one reverse proxy (nginx) so client IPs are correct.
TRUST_PROXY=0

# Max sign-in/sign-up attempts per IP per minute.
THROTTLE_AUTH_LIMIT=5

# Swagger UI at /api/docs. Defaults to on outside production.
# SWAGGER_ENABLED=true

# HTTPS-only cookies. Defaults to true in production.
# COOKIE_SECURE=false
